# --- Required: Aamchi Boli (the public game at "/") ---
GEMINI_API_KEY=your_key_here

# --- Optional Gemini model overrides (defaults shown) ---
BOLI_SCORING_MODEL=gemini-3.5-flash-lite
IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Live-world director; falls back to BOLI_SCORING_MODEL when unavailable.
BOLI_OMNI_MODEL=gemini-omni-1.1-flash

# --- Optional: non-Marathi voice fallback ---
SARVAM_API_KEY=your_sarvam_key_here
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_LANGUAGE=en-IN

# --- Optional: the saved-world routes (/login, /play/[gameId]) ---
# Leave unset to run only the public Aamchi Boli experience.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
TEXT_MODEL=gemini-2.5-flash
# Worlds a non-unlimited account may generate. 0 disables generation.
FREE_GAME_LIMIT=0
NEXT_PUBLIC_SESSION_TIME_LIMIT_SEC=300

# --- Optional: product analytics ---
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Optional: acceptance-check target for `npm run test:aamchi` ---
AAMCHI_BOLI_URL=http://localhost:3000
